# #######################################################################################
	# AUTOGENERATED HYPRLAND CONFIG.
	# PLEASE USE THE CONFIG PROVIDED IN THE GIT REPO /examples/hyprland.conf AND EDIT IT,
	# OR EDIT THIS ONE ACCORDING TO THE WIKI INSTRUCTIONS.
	# #######################################################################################


	autogenerated = 0 # remove this line to remove the warning

	# This is an example Hyprland config file.
	# Refer to the wiki for more information.
	# https://wiki.hyprland.org/Configuring/

	# Please note not all available settings / options are set here.
	# For a full list, see the wiki

	# You can split this configuration into multiple files
	# Create your files separately and then link them to this file like this:
	# source = ~/.config/hypr/myColors.conf


	################
	### MONITORS ###
	################

	# See https://wiki.hyprland.org/Configuring/Monitors/
	monitor=,preferred,auto,auto
	$monitorMain = DP-2
	$monitorLeft = HDMI-A-4
	$monitorRight = DP-3
	$monitorInfo = HDMI-A-5

	$mainMod = SUPER # Sets "Windows" key as main modifier

	# Monitor short names for scripting
	$monitorLeftShort = left
	$monitorMainShort = main
	$monitorRightShort = right
	$monitorInfoShort = info

#	monitor = HDMI-A-4, 1920x1080, 0x0, 1
#	monitor = DP-3, 1920x1080, 1920x0, 1
#	monitor = DP-2, 3840x1600, 0x1080, 1
#	monitor = HDMI-A-5, 1024x600, 3840x0, 1  
	monitor = $monitorLeft, 1920x1080, 0x0, 1  # Left monitor
	monitor = $monitorRight, 1920x1080, 1920x0, 1  # Right monitor
	monitor = $monitorMain, 3840x1600, 0x1080, 1  # Main monitor
	monitor = $monitorInfo, 1024x600, 3840x0, 1  # Info monitor

	# Initial Workspace Definitions
	workspace = name:vd1_ws1_left, monitor:$monitorLeft, default:true
	workspace = name:vd1_ws1_main, monitor:$monitorMain, default:true
	workspace = name:vd1_ws1_right, monitor:$monitorRight, default:true

	workspace = name:fixed_left, monitor:$monitorLeft
	workspace = name:fixed_main, monitor:$monitorMain
	workspace = name:fixed_right, monitor:$monitorRight

	workspace = name:info_conky, monitor:$monitorInfo
#



	###################
	### MY PROGRAMS ###
	###################

	# See https://wiki.hyprland.org/Configuring/Keywords/

	# Set programs that you use
	$terminal = alacritty
	$fileManager = dolphin
	$menu = wofi --show drun

	# Show active windows in workspaces
	bind = $mainMod, W, exec, $scriptsDir/show-windows.sh
	bind = $mainMod, W, exec, $scriptsDir/show-windows.sh
	

	# Custom scripts directory
	$scriptsDir = ~/.config/hypr/scripts

	# Custom Program Shortcuts
	bind = $mainMod ALT, T, exec, wofi --show drun
	

	# Floating Terminal
	bind = $mainMod ALT, F, exec, $terminal --class floating_terminal

	# New Keybindings for Virtual Desktops and Workspaces

	# Virtual Desktop switching
	bind = $mainMod, 1, exec, $scriptsDir/switch_virtual_desktop.sh 1
	bind = $mainMod, 2, exec, $scriptsDir/switch_virtual_desktop.sh 2
	bind = $mainMod, 3, exec, $scriptsDir/switch_virtual_desktop.sh 3
	bind = $mainMod, 4, exec, $scriptsDir/switch_virtual_desktop.sh 4
	bind = $mainMod, 5, exec, $scriptsDir/switch_virtual_desktop.sh 5
	bind = $mainMod, 6, exec, $scriptsDir/switch_virtual_desktop.sh 6
	bind = $mainMod, 7, exec, $scriptsDir/switch_virtual_desktop.sh 7
	bind = $mainMod, 8, exec, $scriptsDir/switch_virtual_desktop.sh 8
	bind = $mainMod, 9, exec, $scriptsDir/switch_virtual_desktop.sh 9
	bind = $mainMod, 0, exec, $scriptsDir/switch_virtual_desktop.sh 10
	bind = $mainMod, right, exec, $scriptsDir/switch_virtual_desktop.sh next
	bind = $mainMod, left, exec, $scriptsDir/switch_virtual_desktop.sh prev

	# Move window to Virtual Desktop
	bind = $mainMod SHIFT, 1, exec, hyprctl dispatch movetoworkspace $(echo vd1_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 2, exec, hyprctl dispatch movetoworkspace $(echo vd2_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 3, exec, hyprctl dispatch movetoworkspace $(echo vd3_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 4, exec, hyprctl dispatch movetoworkspace $(echo vd4_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 5, exec, hyprctl dispatch movetoworkspace $(echo vd5_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 6, exec, hyprctl dispatch movetoworkspace $(echo vd6_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 7, exec, hyprctl dispatch movetoworkspace $(echo vd7_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 8, exec, hyprctl dispatch movetoworkspace $(echo vd8_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 9, exec, hyprctl dispatch movetoworkspace $(echo vd9_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, 0, exec, hyprctl dispatch movetoworkspace $(echo vd10_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
	bind = $mainMod SHIFT, right, exec, $scriptsDir/move_window_to_vd.sh next
	bind = $mainMod SHIFT, left, exec, $scriptsDir/move_window_to_vd.sh prev

	# Workspace switching within current VD (monitor-specific)
	bind = $mainMod, F1, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorLeft
	bind = $mainMod, F2, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorLeft
	bind = $mainMod, F3, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorLeft
	bind = $mainMod, F4, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorMain
	bind = $mainMod, F5, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorMain
	bind = $mainMod, F6, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorMain
	bind = $mainMod, F7, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorRight
	bind = $mainMod, F8, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorRight
	bind = $mainMod, F9, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorRight

	# Cycle workspaces on specific monitor (Super+Alt+arrows)
	bind = $mainMod ALT, left, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh prev $monitorLeft
	bind = $mainMod ALT, right, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh next $monitorLeft
	bind = $mainMod ALT, up, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh prev $monitorMain
	bind = $mainMod ALT, down, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh next $monitorMain

	# Move window to Workspace within current VD (monitor-specific)
	bind = $mainMod SHIFT, F1, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorLeft
	bind = $mainMod SHIFT, F2, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorLeft
	bind = $mainMod SHIFT, F3, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorLeft
	bind = $mainMod SHIFT, F4, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorMain
	bind = $mainMod SHIFT, F5, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorMain
	bind = $mainMod SHIFT, F6, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorMain
	bind = $mainMod SHIFT, F7, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorRight
	bind = $mainMod SHIFT, F8, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorRight
	bind = $mainMod SHIFT, F9, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorRight

	# Move window to next/prev workspace on specific monitor (Super+Alt+Shift+arrows - with switch)
	bind = $mainMod ALT SHIFT, left, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorLeft true
	bind = $mainMod ALT SHIFT, right, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorLeft true
	bind = $mainMod ALT SHIFT, up, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorMain true
	bind = $mainMod ALT SHIFT, down, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorMain true

	# Move window to next/prev workspace on specific monitor (Super+Alt+Ctrl+Shift+arrows - without switch)
	bind = $mainMod ALT CTRL SHIFT, left, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorLeft false
	bind = $mainMod ALT CTRL SHIFT, right, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorMain false
	bind = $mainMod ALT CTRL SHIFT, up, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorMain false
	bind = $mainMod ALT CTRL SHIFT, down, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorMain false

	# Fixed Workspaces
	bind = $mainMod, F10, exec, $scriptsDir/switch_fixed_workspace.sh left
	bind = $mainMod, F11, exec, $scriptsDir/switch_fixed_workspace.sh main
	bind = $mainMod, F12, exec, $scriptsDir/switch_fixed_workspace.sh right

	# Move window to Fixed Workspaces
	bind = $mainMod SHIFT, F10, exec, $scriptsDir/move_window_to_fixed_workspace.sh left
	bind = $mainMod SHIFT, F11, exec, $scriptsDir/move_window_to_fixed_workspace.sh main
	bind = $mainMod SHIFT, F12, exec, $scriptsDir/move_window_to_fixed_workspace.sh right

	bind = $mainMod SHIFT, X, killactive,

	# Standard Hyprland window/focus movement (unchanged)
	bind = $mainMod, left, movefocus, l
	bind = $mainMod, right, movefocus, r
	bind = $mainMod, up, movefocus, u
	bind = $mainMod, down, movefocus, d
	bind = $mainMod SHIFT, left, movewindow, l
	bind = $mainMod SHIFT, right, movewindow, r
	bind = $mainMod SHIFT, up, movewindow, u
	bind = $mainMod SHIFT, down, movewindow, d


	#################
	### AUTOSTART ###
	#################

	# Autostart necessary processes (like notifications daemons, status bars, etc.)
	# Or execute your favorite apps at launch like this:

	# exec-once = $terminal
	# exec-once = nm-applet &
	# exec-once = waybar & hyprpaper & firefox


	#############################
	### ENVIRONMENT VARIABLES ###
	#############################

	# See https://wiki.hyprland.org/Configuring/Environment-variables/

	env = XCURSOR_SIZE,16
	env = HYPRCURSOR_SIZE,16


	#####################
	### LOOK AND FEEL ###
	#####################

	# Refer to https://wiki.hyprland.org/Configuring/Variables/

	# https://wiki.hyprland.org/Configuring/Variables/#general
	general {
	    gaps_in = 5
	    gaps_out = 20

	    border_size = 2

	    # https://wiki.hyprland.org/Configuring/Variables/#variable-types for info about colors
	    col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg
	    col.inactive_border = rgba(595959aa)

	    # Set to true enable resizing windows by clicking and dragging on borders and gaps
	    resize_on_border = false

	    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
	    allow_tearing = false

	    layout = dwindle
	}

	# https://wiki.hyprland.org/Configuring/Variables/#decoration
	decoration {
	    rounding = 10
	    rounding_power = 2

	    # Change transparency of focused and unfocused windows
	    active_opacity = 1.0
	    inactive_opacity = 1.0

	    shadow {
		enabled = true
		range = 4
		render_power = 3
		color = rgba(1a1a1aee)
	    }

	    # https://wiki.hyprland.org/Configuring/Variables/#blur
	    blur {
		enabled = true
		size = 3
		passes = 1

		vibrancy = 0.1696
	    }
	}

	# https://wiki.hyprland.org/Configuring/Variables/#animations
	animations {
	    enabled = yes, please :)

	    # Default animations, see https://wiki.hyprland.org/Configuring/Animations/ for more

	    bezier = easeOutQuint,0.23,1,0.32,1
	    bezier = easeInOutCubic,0.65,0.05,0.36,1
	    bezier = linear,0,0,1,1
	    bezier = almostLinear,0.5,0.5,0.75,1.0
	    bezier = quick,0.15,0,0.1,1

	    animation = global, 1, 10, default
	    animation = border, 1, 5.39, easeOutQuint
	    animation = windows, 1, 4.79, easeOutQuint
	    animation = windowsIn, 1, 4.1, easeOutQuint, popin 87%
	    animation = windowsOut, 1, 1.49, linear, popin 87%
	    animation = fadeIn, 1, 1.73, almostLinear
	    animation = fadeOut, 1, 1.46, almostLinear
	    animation = fade, 1, 3.03, quick
	    animation = layers, 1, 3.81, easeOutQuint
	    animation = layersIn, 1, 4, easeOutQuint, fade
	    animation = layersOut, 1, 1.5, linear, fade
	    animation = fadeLayersIn, 1, 1.79, almostLinear
	    animation = fadeLayersOut, 1, 1.39, almostLinear
	    animation = workspaces, 1, 1.94, almostLinear, fade
	    animation = workspacesIn, 1, 1.21, almostLinear, fade
	    animation = workspacesOut, 1, 1.94, almostLinear, fade
	}

	# Ref https://wiki.hyprland.org/Configuring/Workspace-Rules/
	# "Smart gaps" / "No gaps when only"
	# uncomment all if you wish to use that.
	# workspace = DP-2, 3

windowrulev2 = float, class:^(floating_terminal)$
	# workspace = f[1], gapsout:0, gapsin:0
	# windowrulev2 = bordersize 0, floating:0, onworkspace:w[tv1]
	# windowrulev2 = rounding 0, floating:0, onworkspace:w[tv1]
	# windowrulev2 = bordersize 0, floating:0, onworkspace:f[1]
	# windowrulev2 = rounding 0, floating:0, onworkspace:f[1]

	# See https://wiki.hyprland.org/Configuring/Dwindle-Layout/ for more
	dwindle {
	    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
	    preserve_split = true # You probably want this
	}

	# See https://wiki.hyprland.org/Configuring/Master-Layout/ for more
	master {
	    new_status = master
	}

	# https://wiki.hyprland.org/Configuring/Variables/#misc
	misc {
	    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
	    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
	}


	#############
	### INPUT ###
	#############

	# https://wiki.hyprland.org/Configuring/Variables/#input
	input {
    kb_layout = de
    kb_variant = 
    kb_model = 
    kb_options = caps:escape # Add this for proper key handling, can be adjusted
	    kb_rules = evdev # Crucial for special characters

    follow_mouse = 0

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = false
    }
}

# https://wiki.hyprland.org/Configuring/Variables/#gestures
#gestures {
#    workspace_swipe = false
#}

# Example per-device config
# See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more
device {
    name = epic-mouse-v1
    sensitivity = -0.5
}


###################
### KEYBINDINGS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/


# Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more

# My Custom Keybindings for Virtual Desktops and Workspaces

# Virtual Desktop switching
bind = $mainMod, 1, exec, $scriptsDir/switch_virtual_desktop.sh 1
bind = $mainMod, 2, exec, $scriptsDir/switch_virtual_desktop.sh 2
bind = $mainMod, 3, exec, $scriptsDir/switch_virtual_desktop.sh 3
bind = $mainMod, 4, exec, $scriptsDir/switch_virtual_desktop.sh 4
bind = $mainMod, 5, exec, $scriptsDir/switch_virtual_desktop.sh 5
bind = $mainMod, 6, exec, $scriptsDir/switch_virtual_desktop.sh 6
bind = $mainMod, 7, exec, $scriptsDir/switch_virtual_desktop.sh 7
bind = $mainMod, 8, exec, $scriptsDir/switch_virtual_desktop.sh 8
bind = $mainMod, 9, exec, $scriptsDir/switch_virtual_desktop.sh 9
bind = $mainMod, 0, exec, $scriptsDir/switch_virtual_desktop.sh 10
bind = $mainMod, right, exec, $scriptsDir/switch_virtual_desktop.sh next
bind = $mainMod, left, exec, $scriptsDir/switch_virtual_desktop.sh prev

# Move window to Virtual Desktop
bind = $mainMod SHIFT, 1, exec, hyprctl dispatch movetoworkspace $(echo vd1_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 2, exec, hyprctl dispatch movetoworkspace $(echo vd2_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 3, exec, hyprctl dispatch movetoworkspace $(echo vd3_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 4, exec, hyprctl dispatch movetoworkspace $(echo vd4_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 5, exec, hyprctl dispatch movetoworkspace $(echo vd5_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 6, exec, hyprctl dispatch movetoworkspace $(echo vd6_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 7, exec, hyprctl dispatch movetoworkspace $(echo vd7_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 8, exec, hyprctl dispatch movetoworkspace $(echo vd8_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 9, exec, hyprctl dispatch movetoworkspace $(echo vd9_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, 0, exec, hyprctl dispatch movetoworkspace $(echo vd10_ws1_$(/home/florian/.dotfiles/public/.config/hypr/scripts/get_monitor_shortname.sh $(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'))))
bind = $mainMod SHIFT, right, exec, $scriptsDir/move_window_to_vd.sh next
bind = $mainMod SHIFT, left, exec, $scriptsDir/move_window_to_vd.sh prev

# Workspace switching within current VD (monitor-specific)
bind = $mainMod, F1, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorLeft
bind = $mainMod, F2, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorLeft
bind = $mainMod, F3, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorLeft
bind = $mainMod, F4, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorMain
bind = $mainMod, F5, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorMain
bind = $mainMod, F6, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorMain
bind = $mainMod, F7, exec, $scriptsDir/switch_workspace_in_vd.sh 1 $monitorRight
bind = $mainMod, F8, exec, $scriptsDir/switch_workspace_in_vd.sh 2 $monitorRight
bind = $mainMod, F9, exec, $scriptsDir/switch_workspace_in_vd.sh 3 $monitorRight

# Cycle workspaces on specific monitor (Super+Alt+arrows)
bind = $mainMod ALT, left, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh prev $monitorLeft
bind = $mainMod ALT, right, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh next $monitorLeft
bind = $mainMod ALT, up, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh prev $monitorMain
bind = $mainMod ALT, down, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh next $monitorMain
bind = $mainMod ALT, H, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh prev $monitorRight
bind = $mainMod ALT, L, exec, $scriptsDir/cycle_workspace_on_specific_monitor.sh next $monitorRight

# Move window to Workspace within current VD (monitor-specific)
bind = $mainMod SHIFT, F1, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorLeft
bind = $mainMod SHIFT, F2, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorLeft
bind = $mainMod SHIFT, F3, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorLeft
bind = $mainMod SHIFT, F4, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorMain
bind = $mainMod SHIFT, F5, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorMain
bind = $mainMod SHIFT, F6, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorMain
bind = $mainMod SHIFT, F7, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 1 $monitorRight
bind = $mainMod SHIFT, F8, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 2 $monitorRight
bind = $mainMod SHIFT, F9, exec, $scriptsDir/move_window_to_workspace_in_vd.sh 3 $monitorRight

# Move window to next/prev workspace on specific monitor (Super+Alt+Shift+arrows - with switch)
bind = $mainMod ALT SHIFT, left, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorLeft true
bind = $mainMod ALT SHIFT, right, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorLeft true
bind = $mainMod ALT SHIFT, up, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorMain true
bind = $mainMod ALT SHIFT, down, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorMain true
bind = $mainMod ALT SHIFT, H, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorRight true
bind = $mainMod ALT SHIFT, L, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorRight true

# Move window to next/prev workspace on specific monitor (Super+Alt+Ctrl+Shift+arrows - without switch)
bind = $mainMod ALT CTRL SHIFT, left, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorLeft false
bind = $mainMod ALT CTRL SHIFT, right, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorLeft false
bind = $mainMod ALT CTRL SHIFT, up, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorMain false
bind = $mainMod ALT CTRL SHIFT, down, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorMain false
bind = $mainMod ALT CTRL SHIFT, H, exec, $scriptsDir/move_window_on_specific_monitor.sh prev $monitorRight false
bind = $mainMod ALT CTRL SHIFT, L, exec, $scriptsDir/move_window_on_specific_monitor.sh next $monitorRight false

# Fixed Workspaces
bind = $mainMod, F10, exec, $scriptsDir/switch_fixed_workspace.sh left
bind = $mainMod, F11, exec, $scriptsDir/switch_fixed_workspace.sh main
bind = $mainMod, F12, exec, $scriptsDir/switch_fixed_workspace.sh right

# Move window to Fixed Workspaces
bind = $mainMod SHIFT, F10, exec, $scriptsDir/move_window_to_fixed_workspace.sh left
bind = $mainMod SHIFT, F11, exec, $scriptsDir/move_window_to_fixed_workspace.sh main
bind = $mainMod SHIFT, F12, exec, $scriptsDir/move_window_to_fixed_workspace.sh right

# Standard Hyprland window/focus movement (unchanged)
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d
bind = $mainMod SHIFT, left, movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up, movewindow, u
bind = $mainMod SHIFT, down, movewindow, d
