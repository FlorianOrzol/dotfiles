# Pfad zu deinem Addon-Verzeichnis
set -l addon_base_dir ~/.local/share/pkg-addons/

# Prüfen, ob das Verzeichnis existiert, um Fehler zu vermeiden
if test -d $addon_base_dir
    # Durchlaufe alle Verzeichnisse darin (z.B. pacman, git, etc.)
    for pkg_path in $addon_base_dir/*
        if test -d $pkg_path
            set -l pkg_name (basename $pkg_path)

            # --- TEIL 1: Wrapper-Funktion erstellen ---
            # Wir definieren dynamisch eine Funktion mit dem Namen des Pakets (z.B. 'git').
            # Diese Funktion prüft die Argumente, bevor sie weitermacht.
            function $pkg_name --inherit-variable pkg_name --inherit-variable pkg_path --wraps $pkg_name
                # Prüfen auf --myinfo
                if contains -- --myinfo $argv
                    if test -f "$pkg_path/infos/addon.sh"
                        # Führe das Info-Skript aus (z.B. mit sh oder bash)
                        sh "$pkg_path/infos/addon.sh"
                    else
                        echo "Fehler: $pkg_path/infos/addon.sh nicht gefunden."
                    end
                    return 0
                end

                # Prüfen auf --myfunc
                if contains -- --myfunc $argv
                    if test -f "$pkg_path/functions/addon.sh"
                        # Führe das Function-Skript aus
                        sh "$pkg_path/functions/addon.sh"
                    else
                        echo "Fehler: $pkg_path/functions/addon.sh nicht gefunden."
                    end
                    return 0
                end

                # Wenn keines der speziellen Argumente dabei ist,
                # führe den echten Befehl aus ('command' umgeht die Funktion/Endlosschleife)
                command $pkg_name $argv
            end

            # --- TEIL 2: Completions hinzufügen ---
            # Fügt die Vorschläge zur Tab-Vervollständigung hinzu
            complete -c $pkg_name -l myinfo -d "Addon: Show Info ($pkg_name)"
            complete -c $pkg_name -l myfunc -d "Addon: Execute Function ($pkg_name)"
        end
    end
end
